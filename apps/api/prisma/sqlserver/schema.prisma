// Generated by `solidvs-data derive` from ../schema.prisma. Do not edit:
// change the reference schema and run the command again (ADR-0016).

// Data model of the IT portal (ADR-0016). Written for PostgreSQL, the reference engine, with only
// what every supported engine accepts: `pnpm db:derive` writes the SQL Server version and refuses
// anything else. Change it, then `pnpm db:migration <name>` writes one migration per engine.
generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlserver"
}

/// An administered definition (ADR-0014): one per kind and scope. The portal is its only store;
/// systems read the active version through the API.
model Definition {
  /// `platform/<key>` or `system/<catalog id>/<key>`.
  id            String              @id @db.NVarChar(200)
  key           String              @db.NVarChar(120)
  /// `platform` or `system`.
  scope         String              @db.NVarChar(20)
  systemId      String?             @map("system_id") @db.NVarChar(60)
  /// The version systems receive; none until the first publication.
  activeVersion Int?                @map("active_version")
  /// The draft waiting for publication, if any.
  draftVersion  Int?                @map("draft_version")
  updatedAt     DateTime            @map("updated_at")
  versions      DefinitionVersion[]

  @@index([scope, systemId])
  @@map("definition")
}

/// One version of a definition. Value, note, author and origin never change; publication is
/// stamped once. Rolling back republishes an earlier value as a new version.
model DefinitionVersion {
  definitionId String     @map("definition_id") @db.NVarChar(200)
  number       Int
  /// The value as JSON, validated against the kind's schema of @solidvs/server.
  value        String     @db.NVarChar(Max)
  note         String     @db.NVarChar(500)
  /// The active version when this one was written.
  basedOn      Int?       @map("based_on")
  createdBy    String     @map("created_by") @db.NVarChar(200)
  createdAt    DateTime   @map("created_at")
  publishedBy  String?    @map("published_by") @db.NVarChar(200)
  publishedAt  DateTime?  @map("published_at")
  definition   Definition @relation(fields: [definitionId], references: [id])

  @@id([definitionId, number])
  @@map("definition_version")
}

/// Business audit trail, owned by @solidvs/server (ADR-0016): insert-only, enforced by the
/// database. Keep this model exactly as the platform kit defines it (AUDIT_EVENT_MODEL).
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @map("occurred_at")
  actor       String   @db.NVarChar(200)
  action      String   @db.NVarChar(100)
  subjectType String   @map("subject_type") @db.NVarChar(100)
  subjectId   String?  @map("subject_id") @db.NVarChar(200)
  details     String?  @db.NVarChar(Max)

  @@index([subjectType, subjectId])
  @@map("audit_event")
}
